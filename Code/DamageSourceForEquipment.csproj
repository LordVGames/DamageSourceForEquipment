<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.1</TargetFramework>
		<LangVersion>preview</LangVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<PropertyGroup>
		<RestoreAdditionalProjectSources>
			https://nuget.windows10ce.com/nuget/v3/index.json
		</RestoreAdditionalProjectSources>
		<MonoDetourHookGenNamespace>Mdh</MonoDetourHookGenNamespace>
	</PropertyGroup>

	<PropertyGroup>
		<DebugSymbols>true</DebugSymbols>
		<DebugType>embedded</DebugType>
		<PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'))=./</PathMap>
	</PropertyGroup>

	<PropertyGroup>
		<AssemblyName>Lordryn.DamageSourceForEquipment</AssemblyName>
		<AssemblyTitle>DamageSourceForEquipment</AssemblyTitle>
		<Version>2.0.2</Version>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="BepInEx.Analyzers" Version="1.0.*">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>

		<PackageReference Include="BepInEx.Core" Version="5.4.21" />

		<PackageReference Include="Hamunii.BepInEx.AutoPlugin" Version="2.1.0">
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		  <PrivateAssets>all</PrivateAssets>
		</PackageReference>

		<PackageReference Include="MonoDetour" Version="0.7.16" />

		<PackageReference Include="MonoDetour.HookGen" Version="0.7.14" />

		<PackageReference Include="R2API.ProcType" Version="1.0.2" />

		<PackageReference Include="RoR2BepInExPack" Version="1.47.0" />

		<PackageReference Include="score-MiscFixes" Version="1.6.1" />

		<PackageReference Include="UnityEngine.Modules" Version="2021.3.45" IncludeAssets="compile" />
		<PackageReference Include="RiskOfRain2.GameLibs" Version="1.5.0-r.1" />
		<PackageReference Include="MMHOOK.RoR2" Version="2026.10.8" NoWarn="NU1701" />
	</ItemGroup>

	<ItemGroup>
	  <Reference Include="ItemStatistics">
	    <HintPath>..\..\! Assemblies to reference\ItemStatistics.dll</HintPath>
	  </Reference>
	</ItemGroup>

	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
	  <Exec Command="set profilePluginsFolder=F:\Various Caches 2\Gale\Data\riskofrain2\profiles\close to vanilla TEST WITH MOD\BepInEx\plugins&#xD;&#xA;set thunderstorePluginsFolder=$(ProjectDir)..\Thunderstore\Package Files\plugins&#xD;&#xA;&#xD;&#xA;start /wait taskkill /f /im &quot;Risk of Rain 2.exe&quot;&#xD;&#xA;start /wait timeout /t 2&#xD;&#xA;&#xD;&#xA;copy /y &quot;$(TargetDir)$(TargetName).dll&quot; &quot;%25profilePluginsFolder%25&quot;&#xD;&#xA;copy /y &quot;$(TargetDir)$(TargetName).dll&quot; &quot;%25thunderstorePluginsFolder%25&quot;&#xD;&#xA;del &quot;%25thunderstorePluginsFolder%25\$(ProjectName).dll&quot;&#xD;&#xA;rename &quot;%25thunderstorePluginsFolder%25\$(TargetName).dll&quot; &quot;$(ProjectName).dll&quot;&#xD;&#xA;&#xD;&#xA;copy /y &quot;$(ProjectDir)..\README.md&quot; &quot;%25thunderstorePluginsFolder%25\..\README.md&quot;&#xD;&#xA;&#xD;&#xA;&quot;C:\Program Files\7-Zip\7z.exe&quot; a -tzip &quot;$(ProjectDir)..\Thunderstore\$(ProjectName).zip&quot; -x!*.zip &quot;$(ProjectDir)..\Thunderstore\Package Files\*&quot;&#xD;&#xA;&#xD;&#xA;rem start &quot;&quot; &quot;E:\RoR2 Modding\StartRor2MultiplayerTest.ahk&quot;&#xD;&#xA;start &quot;&quot; &quot;D:\Steam on SSD\steamapps\common\Risk of Rain 2\Risk of Rain 2.exe - Close to Vanilla Test WITH MOD.lnk&quot;" />
